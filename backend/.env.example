# Скопируй этот файл в .env и при необходимости измени значения
DATABASE_URL=postgresql+asyncpg://wms_user:wms_pass@db:5432/wms_db
DATABASE_URL_SYNC=postgresql+psycopg2://wms_user:wms_pass@db:5432/wms_db
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
